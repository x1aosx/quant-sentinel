# 部署示例配置：复制为 deploy/.env 并按目标环境替换。
HOST_PORT=18080
IMAGE_TAG=latest
REGISTRY=registry.shawsx.com:8443
PROJECT_NAME=quant-sentinel
TZ=Asia/Shanghai
XQUANT_DB_PATH=/app/data/xquant.db
# Storage selection. Set XQUANT_STORAGE_CONFIG_FILE to a secure file path if you
# want the API to load connection settings from an external config file.
XQUANT_REQUIRED_ENV_VARS=TZ,STORAGE_BACKEND,POSTGRES_HOST,REDIS_HOST,INFLUXDB_URL
STORAGE_BACKEND=postgres

# PostgreSQL
POSTGRES_HOST=change-me
POSTGRES_PORT=5432
POSTGRES_DB=quant-sentinel
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=change-me
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# InfluxDB 3
INFLUXDB_URL=https://change-me:8181
INFLUXDB_DATABASE=quant-sentinel
INFLUXDB_TOKEN=change-me

# Optional local helper services: docker compose --profile storage-local up -d
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
INFLUXDB_IMAGE=influxdb:3-core
DATA_VOLUME=quant-sentinel-data
LOG_VOLUME=quant-sentinel-logs
